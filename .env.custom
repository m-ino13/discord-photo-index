# 設定ファイル(Git管理する。秘密情報は書かない。Botのトークンは .env に書く)

# --- 必須 ---
# 検索対象サーバーのID
GUILD_ID=
# 一覧の投稿先チャンネルのID
OUTPUT_CHANNEL_ID=

# --- 任意(省略した場合の既定値は、行末の括弧内) ---
# 画像がこの枚数以上の投稿を対象にする(5)
MIN_IMAGES=5
# 直前に採用した投稿からこの時間(時間)以内、または同じ日なら、連投とみなして除外する(3)
GAP_HOURS=3
# 「同じ日」の判定と、表示する日付に使うタイムゾーン(Asia/Tokyo)
TIMEZONE=Asia/Tokyo
